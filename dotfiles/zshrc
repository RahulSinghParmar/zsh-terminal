# Managed by zsh-terminal. Put private, machine-specific additions in .zshrc.local.
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Also initialize PATH for interactive non-login shells (e.g. editor terminals).
if (( ! $+commands[brew] )); then
  if [[ $(uname -m) == arm64 && -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi
typeset -U path PATH
path=("$HOME/.local/bin" $path)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
# Record upgrades deliberately; don't silently change pinned framework revisions.
zstyle ':omz:update' mode disabled
plugins=(git web-search)
for _macenv_plugin in zsh-autosuggestions; do
  [[ -r "$ZSH/custom/plugins/$_macenv_plugin/$_macenv_plugin.plugin.zsh" ]] && plugins+=($_macenv_plugin)
done
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
unset _macenv_plugin
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
[[ -r "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

(( $+commands[fzf] )) && eval "$(fzf --zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[atuin] )) && eval "$(atuin init zsh)"
if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --group-directories-first'
  alias la='eza -la --icons --group-directories-first'
fi
(( $+commands[nnn] )) && alias n='nnn'

# Load NVM exactly once, preferring an existing standalone installation.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif (( $+commands[brew] )); then
  _macenv_brew_prefix=${HOMEBREW_PREFIX:-$(brew --prefix)}
  [[ -s "$_macenv_brew_prefix/opt/nvm/nvm.sh" ]] && source "$_macenv_brew_prefix/opt/nvm/nvm.sh"
  unset _macenv_brew_prefix
fi

# Optional tools: no stale TeX version path or Java error on a fresh Mac.
for _macenv_dir in "$HOME/.console-ninja/.bin" /Library/TeX/texbin "$HOME/.spicetify"; do
  [[ -d "$_macenv_dir" ]] && path=("$_macenv_dir" $path)
done
unset _macenv_dir
if [[ -x /usr/libexec/java_home ]]; then
  _macenv_java=$(/usr/libexec/java_home 2>/dev/null) && export JAVA_HOME="$_macenv_java"
  unset _macenv_java
fi
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
# Highlighting must be sourced after tools/private widgets have been registered.
[[ -r "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
:
